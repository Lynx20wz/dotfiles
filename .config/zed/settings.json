{
  "semantic_tokens": "combined",
  "diff_view_style": "unified",
  "completion_menu_item_kind": "symbol",
  "tabs": {
    "file_icons": false,
  },
  "title_bar": {
    "show_branch_status_icon": false,
  },
  "collaboration_panel": {
    "button": false,
  },
  "fast_scroll_sensitivity": 3.0,
  "scroll_sensitivity": 1.0,
  "inlay_hints": {
    "show_value_hints": true,
    "show_background": false,
    "show_other_hints": true,
    "show_parameter_hints": false,
    "enabled": true,
  },
  "completion_detail_alignment": "right",
  "completion_menu_scrollbar": "never",
  "completions": {
    "words_min_length": 1,
    "words": "enabled",
  },
  "inline_code_actions": true,
  "gutter": {
    "min_line_number_digits": 3,
    "runnables": true,
  },
  "autoscroll_on_clicks": false,
  "which_key": {
    "enabled": false,
  },
  "outline_panel": {
    "dock": "left",
  },
  "project_panel": {
    "dock": "left",
  },
  "cli_default_open_behavior": "new_window",
  "mouse_wheel_zoom": true,
  "git_panel": {
    "sort_by_path": false,
    "dock": "left",
    "tree_view": false,
  },
  "agent_servers": {
    "qwen-code": {
      "type": "custom",
      "command": "qwen",
      "args": ["--acp"],
      "env": {},
    },
  },
  "calls": {
    "share_on_join": true,
    "mute_on_join": false,
  },
  "audio": {
    "experimental.auto_microphone_volume": true,
  },
  "excerpt_context_lines": 4,
  "ui_font_family": "Monaspace Argon NF",
  "buffer_font_weight": 400.0,
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "default_profile": "write",
    "default_model": {
      "enable_thinking": false,
      "provider": "ollama",
      "model": "deepseek-coder:6.7b",
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "snippet_sort_order": "bottom",
  "indent_guides": {
    "coloring": "indent_aware",
  },
  "languages": {
    "Svelte": {
      "tab_size": 2
    },
    "Markdown": {
      "hard_tabs": false,
      "tab_size": 4,
    },
    "Dart": {
      "preferred_line_length": 100,
      "completions": {
        "words_min_length": 3,
      },
      "indent_guides": {
        "coloring": "indent_aware",
        "background_coloring": "disabled",
      },
      "tab_size": 2,
    },
    "Python": {
      "prettier": {
        "allowed": false
      },
      "document_symbols": "on",
      "inlay_hints": {
        "enabled": true,
      },
      "format_on_save": "on",
      "indent_guides": {
        "coloring": "indent_aware",
        "background_coloring": "disabled",
      },
    },
  },
  "auto_signature_help": false,
  "show_signature_help_after_edits": false,
  "always_treat_brackets_as_autoclosed": false,
  "colorize_brackets": true,
  "redact_private_values": false,
  "relative_line_numbers": "disabled",
  "allow_rewrap": "in_comments",
  "preferred_line_length": 91,
  "show_wrap_guides": true,
  "edit_predictions": {
    "mode": "subtle",
    "provider": "zed",
    "ollama": { "model": "deepseek-coder:6.7b", "prompt_format": "deepseek_coder" },
  },
  "horizontal_scroll_margin": 1.0,
  "scrollbar": {
    "axes": {
      "horizontal": true,
    },
  },
  "toolbar": {
    "agent_review": false,
    "selections_menu": false,
    "quick_actions": false,
    "breadcrumbs": false,
    "code_actions": false,
  },

  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "terminal": {
    "alternate_scroll": "on",
    "scroll_multiplier": 3.0,
    "shell": {
      "program": "nu",
    },
    "font_size": 22.0,
    "cursor_shape": "bar",
  },
  "git": {
    "inline_blame": {
      "enabled": true,
    },
  },
  "base_keymap": "VSCode",
  "sticky_scroll": {
    "enabled": false,
  },
  "minimap": {
    "show": "never",
  },
  "cursor_blink": true,
  "autosave": "on_focus_change",
  "buffer_font_family": "Monaspace Argon NF",
  "soft_wrap": "editor_width",
  "icon_theme": "Material Icon Theme",
  "ui_font_size": 14.0,
  "buffer_font_size": 18.0,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Ayu Mirage",
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
      "padding": 2,
      "update_debounce_ms": 300,
    },
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "completion": {
          "snippits": {
            "custom": {
              "Enclose ok": {
                "postfix": "ok",
                "body": ["Ok(${receiver})"],
                "scope": "expr",
              },
            },
          },
        },
        "inlayHints": {
          "maxLength": null,
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
            "useParameterNames": true,
          },
          "closureReturnTypeHints": {
            "enable": "always",
          },
        },
      },
    },
    "basedpyright": {
      "settings": {},
    },
  },
}
