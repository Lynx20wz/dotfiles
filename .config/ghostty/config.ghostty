# https://ghostty.org/docs/config/keybind
# https://gist.github.com/hensg/43bc71c21d1f79385892352a390aa2ca

theme = Ayu Mirage
shell-integration = fish

keybind = f5=reload_config

keybind = ctrl+shift+c=unbind
keybind = ctrl+shift+v=unbind
keybind = ctrl+shift+t=unbind
keybind = ctrl+shift+a=unbind

keybind = ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+f=start_search
keybind = ctrl+shift+f=search_selection
keybind = ctrl+t=new_tab
keybind = ctrl+a=select_all

keybind = ctrl+shift+up=jump_to_prompt:-1
keybind = ctrl+shift+down=jump_to_prompt:1

keybind = ctrl+\=new_split:right
keybind = ctrl+'=new_split:down

keybind = ctrl+x=close_tab
