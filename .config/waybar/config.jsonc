{
  // "layer": "top", // Waybar at top layer
  // "position": "bottom", // Waybar position (top|bottom|left|right)
  "width": 2550,
  "height": 25,
  "spacing": 4,
  "modules-left": ["hyprland/workspaces", "custom/music"],
  "modules-center": ["clock"],
  "modules-right": [
    "custom/obs",
    "network",
    // "custom/english",
    "pulseaudio",
    "custom/audio",

    "hyprland/language",
    "keyboard-state",
    "tray",
  ],

  // LEFT
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "9": "󰖟",
      "10": "♫",
    },
  },
  "custom/music": {
    "escape": true,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "exec": "playerctl metadata --format '♫ {{artist}} - {{title}}' 2>/dev/null",
    "tooltip": false,
    "interval": 2,
    "max-length": 50,
  },
  "keyboard-state": {
    "numlock": true,
    "capslock": true,
    "format": "{name} {icon}",
    "format-icons": {
      "locked": "",
      "unlocked": "",
    },
  },

  // RIGHT
  "network": {
    "format": "{ifname}",
    "format-wifi": "{essid}",
    "format-ethernet": "{ipaddr}/{cidr} 󰊗",
    "format-disconnected": "",
    "tooltip-format": "{ifname} via {gwaddr} 󰊗",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) \n{ipaddr}\n{gwaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50,
    "on-click": "alacritty -e gazelle",
  },
  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon}  {volume}%",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": "  {icon} {format_source}",
    "format-muted": "  {format_source}",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "default": ["", "", ""],
    },
    "on-click": "pavucontrol",
  },
  "custom/audio": {
    "exec": "/mnt/data/documents/dotfiles/.config/waybar/custom/audio-switcher.sh icon",
    "return-type": "json",
    "interval": 3,
    "on-click": "/mnt/data/documents/dotfiles/.config/waybar/custom/audio-switcher.sh switch",
    "tooltip": true,
  },
  "custom/obs": {
    "exec": "/mnt/data/documents/dotfiles/.config/waybar/custom/obs-waybar-plugin -b 'black screen'",
    "return-type": "json",
    "interval": 1,
  },
  "clock": {
    "format": "{:%I:%M:%S%p}",
    "format-alt": "{:%Y-%m-%d}",
    "tooltip-format": "<big>{:%H:%M:%S}</big>\n<tt><small>{calendar}</small></tt>",
    "interval": 1,
  },
  "hyprland/language": {
    "format-en": "🇺🇸",
    "format-ru": "🇷🇺",
  },
  "tray": {
    "spacing": 10,
  },
}
